node_modules/
# dist/ is no longer ignored: the Dockerfiles copy the pre-built dist folders
**/src/public/css/style.css
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map
.env

# Correction: added to exclude macOS Finder metadata files, not present
# on the Windows machine where this .gitignore was originally created.
# https://docs.github.com/en/get-started/git-basics/ignoring-files
.DS_Store

# Local SQLite database and TypeScript build cache, both generated at
# runtime and not part of the source code.
*.sqlite
*.tsbuildinfo
